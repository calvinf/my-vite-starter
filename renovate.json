{
  "customManagers": [
    {
      "customType": "regex",
      "description": "Keep hk.pkl schema pins on the same hk release as mise.toml",
      "managerFilePatterns": ["/^hk\\.pkl$/"],
      "matchStrings": [
        "package://github\\.com/jdx/hk/releases/download/v(?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)/hk@",
        "package://github\\.com/jdx/hk/releases/download/v[0-9]+\\.[0-9]+\\.[0-9]+/hk@(?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)#",
        "min_hk_version\\s*=\\s*\"(?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)\""
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "hk",
      "packageNameTemplate": "jdx/hk",
      "extractVersionTemplate": "^v(?<version>.*)$",
      "versioningTemplate": "semver"
    }
  ],
  "packageRules": [
    {
      "description": "Restrict @types/node to the latest node LTS version",
      "matchManagers": ["npm"],
      "matchPackageNames": ["@types/node"],
      "allowedVersions": "/^24\\./"
    },
    {
      "description": "Restrict React to v19.x",
      "matchPackageNames": ["react", "react-dom"],
      "allowedVersions": "/^19\\./"
    },
    {
      "description": "Restrict Tailwind CSS to v4.x",
      "matchPackageNames": ["tailwindcss", "@tailwindcss/vite"],
      "allowedVersions": "/^4\\./"
    },
    {
      "description": "Group React ecosystem packages",
      "matchPackagePatterns": [
        "^react$",
        "^react-dom$",
        "^@types/react",
        "^@vitejs/plugin-react"
      ],
      "groupName": "react ecosystem"
    },
    {
      "description": "Group Testing Library packages",
      "matchPackagePatterns": ["^@testing-library/"],
      "groupName": "testing library"
    },
    {
      "description": "Group Oxc packages",
      "matchPackagePatterns": ["^oxlint", "^@oxlint/", "^oxfmt"],
      "groupName": "oxc"
    },
    {
      "description": "Group TypeScript type definitions",
      "matchPackagePatterns": ["^@types/"],
      "groupName": "typescript types"
    },
    {
      "description": "Group Tailwind CSS packages",
      "matchPackagePatterns": ["^tailwindcss", "^@tailwindcss/"],
      "groupName": "tailwind css"
    }
  ],
  "schedule": ["before 10am on monday"],
  "timezone": "America/Los_Angeles"
}
